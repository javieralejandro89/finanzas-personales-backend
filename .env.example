# Configuración del Servidor
NODE_ENV=development
PORT=5000

# Base de datos MySQL
DATABASE_URL="mysql://usuario:password@localhost:3306/finanzas_db"

# JWT Secrets (CAMBIAR EN PRODUCCIÓN)
JWT_ACCESS_SECRET=tu_secret_super_seguro_access_token_aqui_cambiar_en_produccion
JWT_REFRESH_SECRET=tu_secret_super_seguro_refresh_token_aqui_cambiar_en_produccion

# Duración de tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Configuración de moneda por defecto
DEFAULT_CURRENCY=MXN